# 部署到线上时改成你的真实地址，RSS / sitemap / OG 链接会使用它
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL（从 Neon 控制台复制 pooled connection string）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require"

# 首次 seed 时创建的主人账号（登录后请立刻修改初始密码）
OWNER_USERNAME=qinwei
OWNER_INITIAL_PASSWORD=change-me

# Backblaze B2 S3-compatible storage.
# Create a bucket-scoped Application Key; never use the Master Application Key.
B2_BUCKET=quiet-wisp
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
# Keep empty while the bucket is private; album pages use signed URLs.
B2_PUBLIC_BASE_URL=
B2_KEY_PREFIX=diary

# 工信部备案完成后填写；留空时页脚会显示待填写提示
NEXT_PUBLIC_ICP_NUMBER=
