# 部署到线上时改成你的真实地址，RSS / sitemap / OG 链接会使用它
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL（从 Neon 控制台复制 pooled connection string）
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full&channel_binding=require"

# 首次 seed 时创建的主人账号（登录后请立刻修改初始密码）
OWNER_USERNAME=qinwei
OWNER_INITIAL_PASSWORD=change-me

# Private S3-compatible object storage (iDrive e2).
OBJECT_STORAGE_BUCKET=diary-weiqin
OBJECT_STORAGE_REGION=ap-southeast-2
OBJECT_STORAGE_ENDPOINT=https://s3.ap-southeast-2.idrivee2.com
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# 仅运行迁移脚本时需要；迁移完成后可从本机 .env 删除。
SOURCE_OBJECT_STORAGE_BUCKET=旧对象存储桶名
SOURCE_OBJECT_STORAGE_REGION=旧对象存储区域
SOURCE_OBJECT_STORAGE_ENDPOINT=https://old-storage.example.com
SOURCE_OBJECT_STORAGE_ACCESS_KEY_ID=旧对象存储访问密钥 ID
SOURCE_OBJECT_STORAGE_SECRET_ACCESS_KEY=旧对象存储 Secret Access Key

# 工信部备案完成后填写；留空时页脚会显示待填写提示
NEXT_PUBLIC_ICP_NUMBER=
