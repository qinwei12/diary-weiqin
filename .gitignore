# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# diary data (created on first run)
/data/posts.json
/data/posts.backup.json
/data/.posts.*.tmp

# uploaded photos
/public/uploads/*
!/public/uploads/.gitkeep

# local env (checked-in example below)
!.env.example


# Private database migration snapshots (may contain password/session hashes)
/data/database-backups/
